{
  "name": "@trace-pilot/vite-plugin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Injects Debug IDs into Vite build output and uploads hidden source maps to TracePilot",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@trace-pilot/shared": "workspace:*"
  },
  "peerDependencies": {
    "vite": ">=7"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "source-map": "^0.8.0",
    "tsdown": "^0.23.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
