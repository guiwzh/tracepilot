PORT=4318
HOST=127.0.0.1
# 数据库与 Source Map 默认放在 apps/server/.tracepilot/。需要覆盖时请写绝对路径：
# 服务端以 apps/server 为工作目录启动，相对路径会被解析成 apps/server/apps/server/...，
# 而那个位置不在 .gitignore 里，数据库文件可能被误提交。
# DATABASE_PATH=/absolute/path/tracepilot.db
# SOURCEMAP_DIR=/absolute/path/source-maps

# 诊断层的外部模型。留空 MODEL_API_KEY 即降级到确定性的本地证据引擎，
# 离线演示与全部测试都不需要密钥。
#
# 适配层按端点能力降级，不按厂商名字硬编码：
#   1. Responses API + Zod 结构化输出
#   2. chat/completions + json_object + 提示词内嵌 schema
# 两条路径最终都要过同一个共享 Zod Schema 才会落库。
#
# 已实测可接入（2026-08-31）：
#   OpenAI     MODEL_API_URL=https://api.openai.com/v1
#   DeepSeek   MODEL_API_URL=https://api.deepseek.com/v1   MODEL_NAME=deepseek-chat
#
# 其他 OpenAI 兼容端点（通义千问、豆包、Kimi 等）未实测，
# 但只要实现了上述两条路径之一即可接入。
#
# 排障 Agent 使用流式 chat/completions 的工具调用（tools + tool_choice）。
# 这条路径目前只对本地模拟端点测试过，尚未对真实服务商实测。
MODEL_API_URL=https://api.openai.com/v1
MODEL_API_KEY=
MODEL_NAME=gpt-5.6-terra

# 排障 Agent 会把出错行前后几行源码发给模型服务商；有合规要求时设为 false。
AGENT_SOURCE_CONTEXT=true
# 没有密钥时离线演示脚本每一步的停顿（毫秒），让调查过程在界面上看得清。
LOCAL_AGENT_STEP_DELAY_MS=450
# 评测可选：用另一个模型当裁判，减少与被测模型同源的自我偏好。
# EVAL_JUDGE_MODEL=

VITE_API_URL=http://localhost:4318
VITE_DEMO_PROJECT_ID=demo-project
VITE_DEMO_DSN_KEY=demo-dsn-key
