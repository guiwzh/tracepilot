{
  "name": "trace-pilot",
  "version": "0.1.0",
  "private": true,
  "description": "TracePilot — frontend observability and evidence-grounded AI diagnosis",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "concurrently -n shared,sdk,server,dashboard,playground -c blue,magenta,yellow,cyan,green \"pnpm --filter @trace-pilot/shared dev\" \"pnpm --filter @trace-pilot/monitor-sdk dev\" \"pnpm --filter @trace-pilot/server dev\" \"pnpm --filter @trace-pilot/dashboard dev\" \"pnpm --filter @trace-pilot/playground dev\"",
    "build": "pnpm -r --sort run build",
    "typecheck": "tsc -p tsconfig.json && pnpm -r --sort run typecheck",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r --if-present run test",
    "test:e2e": "playwright test",
    "benchmark": "pnpm --filter @trace-pilot/server benchmark",
    "evaluate:diagnosis": "pnpm --filter @trace-pilot/server evaluate:diagnosis",
    "evaluate:agent": "pnpm --filter @trace-pilot/server evaluate:agent",
    "measure:sdk": "node scripts/measure-sdk.mjs",
    "seed": "pnpm --filter @trace-pilot/server seed",
    "smoke:production": "node scripts/smoke-production.mjs",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm measure:sdk && pnpm smoke:production",
    "screenshots": "playwright test --config playwright.screenshots.config.ts",
    "measure:sdk-runtime": "node scripts/measure-sdk-runtime.mjs",
    "measure:chart": "node scripts/measure-chart-update.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.19.0",
    "concurrently": "^9.2.4",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "source-map": "^0.7.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1"
  }
}
