{
  "name": "@trace-pilot/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsup src/index.ts --format esm --sourcemap --clean --external better-sqlite3",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "seed": "tsx src/seed.ts",
    "benchmark": "tsx src/benchmark.ts",
    "evaluate:diagnosis": "tsx src/evaluate.ts",
    "evaluate:agent": "tsx src/eval/run.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/multipart": "^9.4.0",
    "@trace-pilot/shared": "workspace:*",
    "better-sqlite3": "^12.11.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "openai": "^5.23.2",
    "source-map": "^0.7.6",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.19.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "vitest": "^3.2.7"
  }
}
